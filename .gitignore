# 运行产物（每次分析生成的时间戳结果目录，含模拟数据/图表/Word报告）
outputs/

# 项目内专属依赖库：R 包与 Python 依赖默认装在这里（随项目文件夹走、免管理员权限）。
# 这是本机可再生内容，不入库，也不应进发布包。
.psychostat/

# 项目内运行时（可选布局）：随包的 R / Python 可放在 runtime\R 与 runtime\Python，
# 由 psychostat_env.ps1 相对项目文件夹优先查找。体积数百 MB、绑本机环境，不入库；
# 需要随包分发时由打包脚本单独装入（见 notes\make_portable_release.ps1）。
/runtime/

# 打包时生成的合并版分支说明（三个分支说明书的合并 Word 版；源是 docs/*.md，
# 由 scripts/merge_manuals.py 在打包时产出，不随仓库保存）
/Psychostat 分支使用说明.docx

# Python 缓存
__pycache__/
*.pyc

# Office 临时文件
~$*.docx
~$*.xlsx

# 本地临时/凭据文件（如发布前放置 token 等，切勿提交）
.github_token.txt

# 内部交接/工作笔记（本地保留，不入库）
notes/

# 由 md 生成的 Word 版（docs/*.md 才是唯一源，docx 属可再生产物，不入库）
docs/*.docx

# 私有数据保护：真实研究数据请放在下列目录，绝不入库
data/
private/
local/
secrets/
.env
*.sav
*.xlsx
*.xls
!examples/*.sav
!examples/*.xlsx
!examples/*.xls
!tests/data/
!tests/data/*.csv

# 操作系统杂项
.DS_Store
Thumbs.db

# macOS：Python 依赖虚拟环境（首次运行时自动创建）与验证工具临时目录
.venv/
.piptmp/

# 开发期临时脚本（下划线开头；绝不可进发布包）
_*.R
_*.tmp
*.saving
